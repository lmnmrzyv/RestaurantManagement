<UserControl x:Class="RestaurantManagement.Views.Components.HeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RestaurantManagement.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="800">
    <Border Background="Red" BorderThickness="0" CornerRadius="10" Padding="10" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" ShadowDepth="4"/>
        </Border.Effect>
        <Border Background="OrangeRed" CornerRadius="5">
            <TextBlock Height="50" FontSize="24" Foreground="White" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Text="{Binding Header}" Padding="10">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.7" ShadowDepth="2"/>
                </TextBlock.Effect>
            </TextBlock>
        </Border>
    </Border>
</UserControl>
