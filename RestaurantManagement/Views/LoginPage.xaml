<Window x:Class="RestaurantManagement.Views.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RestaurantManagement.Views"
        xmlns:viewmodels="clr-namespace:RestaurantManagement.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:LoginViewModel}"
        mc:Ignorable="d"
        Height="480" Width="500"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Border CornerRadius="12" BorderThickness="1" BorderBrush="#CCCCCC" Margin="25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="5" Color="#888888" />
            </Border.Effect>
            <Grid Background="#FFFFFF">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="300">
                    <Label Content="Hi,&#xA;Welcome!" FontFamily="Segoe UI" FontSize="32" Height="100" Margin="0,0,0,20" Background="Transparent" Foreground="#333333">
                        <Label.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#888888"/>
                        </Label.Effect>
                    </Label>

                    <TextBlock Text="Username" Background="Transparent" FontFamily="Segoe UI" FontSize="16" Foreground="#666666" Margin="10,0,0,5"/>
                    <TextBox Margin="10,0,0,0" BorderThickness="1" BorderBrush="#CCCCCC" Padding="5" Text="{Binding User.Username, Mode=OneWayToSource}"
                             Foreground="#333333" Background="#F5F5F5" FontFamily="Segoe UI" FontSize="16">
                        <TextBox.InputBindings>
                            <KeyBinding Command="{Binding Path=SignIn}" CommandParameter="{Binding ElementName=PasswordTxt}" Key="Enter" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <Separator BorderBrush="#E0E0E0" Margin="10,5"/>

                    <TextBlock Text="Password" Background="Transparent" FontFamily="Segoe UI" FontSize="16" Foreground="#666666" Margin="10,0,0,5"/>
                    <PasswordBox Margin="10,0,0,0" x:Name="PasswordTxt" Background="#F5F5F5" BorderThickness="1" BorderBrush="#CCCCCC" Padding="5" Foreground="#333333" FontFamily="Segoe UI" FontSize="16">
                        <PasswordBox.InputBindings>
                            <KeyBinding Command="{Binding Path=SignIn}" CommandParameter="{Binding ElementName=PasswordTxt}" Key="Enter" />
                        </PasswordBox.InputBindings>
                    </PasswordBox>

                    <Separator BorderBrush="#E0E0E0" Margin="10,5"/>

                    <TextBlock Text="Username or password is incorrect" Background="Transparent" FontFamily="Segoe UI" FontSize="14" Foreground="Red" Margin="10,0,0,10" Visibility="{Binding ErrorVisibility}"/>

                    <Button Height="40" Content="Sign in" Width="120" BorderThickness="0" Background="OrangeRed" Foreground="White" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Command="{Binding SignIn}" CommandParameter="{Binding ElementName=PasswordTxt}" Margin="0,10,0,0">
                        <Button.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Color="Orange"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
