<UserControl x:Class="RestaurantManagement.Views.Controls.EmployeesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RestaurantManagement.Views.Controls"
             xmlns:viewmodels="clr-namespace:RestaurantManagement.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:EmployeesViewModel}"
             xmlns:components="clr-namespace:RestaurantManagement.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="White" BorderThickness="5" CornerRadius="10" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" ShadowDepth="4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <components:HeaderControl/>
                <Border Background="LightGray" CornerRadius="10" Padding="10" Margin="0 0 0 10">
                    <Grid Margin="10" Style="{StaticResource grdForm}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Height="25" FontSize="15" HorizontalAlignment="Left" FontFamily="TIMES NEW ROMAN" Foreground="Black">Name</TextBlock>
                            <TextBox FontSize="15" Height="25" HorizontalAlignment="Left" Width="200" FontFamily="TIMES NEW ROMAN" Text="{Binding CurrentEmployees.Name, Mode=TwoWay}"/>
                            <TextBlock Height="25" FontSize="15" HorizontalAlignment="Left" FontFamily="TIMES NEW ROMAN" Foreground="Black">Surname</TextBlock>
                            <TextBox FontSize="15" Height="25" HorizontalAlignment="Left" Width="200" FontFamily="TIMES NEW ROMAN" Text="{Binding CurrentEmployees.Surname, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Height="25" FontSize="15" HorizontalAlignment="Left" FontFamily="TIMES NEW ROMAN" Foreground="Black">Position</TextBlock>
                            <ComboBox ItemsSource="{Binding Positions}" SelectedItem="{Binding CurrentEmployees.Position , Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="Name" Height="25" HorizontalAlignment="Left" Width="200"/>
                            <TextBlock Height="25" FontSize="15" HorizontalAlignment="Left" FontFamily="TIMES NEW ROMAN" Foreground="Black">Education Level</TextBlock>
                            <ComboBox ItemsSource="{Binding EducationLevels}" SelectedItem="{Binding CurrentEmployees.EducationLevel, Mode=TwoWay}" Height="25" HorizontalAlignment="Left" Width="200"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Height="25" FontSize="15" HorizontalAlignment="Left" FontFamily="TIMES NEW ROMAN" Foreground="Black">Performance Rating</TextBlock>
                            <TextBox FontSize="15" Height="25" HorizontalAlignment="Left" Width="200" FontFamily="TIMES NEW ROMAN" Text="{Binding CurrentEmployees.PerformanceRating, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10" Grid.Row="1" HorizontalAlignment="Center">
                <Button Style="{StaticResource btnAdd}" Width="120" Height="40" Margin="5" Content="Add"/>
                <Button Style="{StaticResource btnChange}" Width="120" Height="40" Margin="5" Content="Edit"/>
                <Button Style="{StaticResource btnSave}" Width="120" Height="40" Margin="5" Content="Save"/>
                <Button Style="{StaticResource btnReject}" Width="120" Height="40" Margin="5" Content="Reject"/>
                <Button Style="{StaticResource btnDelete}" Width="120" Height="40" Margin="5" Content="Delete"/>
            </StackPanel>
            <ListView ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployees, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource listViewCustom}" Margin="10" Grid.Row="2">
                <ListView.View>
                    <GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=No}" Header="No" Width="50"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=Name}" Header="Name" Width="100"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=Surname}" Header="Surname" Width="100"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=Position.Name}" Header="Position" Width="100"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=EducationLevel}" Header="Education Level" Width="150"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=PerformanceRating}" Header="Performance Rating" Width="150"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <Grid Grid.Row="3" Style="{StaticResource grdSearch}" HorizontalAlignment="Right" Margin="10">
                <components:SearchControl/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
