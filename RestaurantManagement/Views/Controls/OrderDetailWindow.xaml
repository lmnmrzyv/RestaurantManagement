<Window x:Class="RestaurantManagement.Views.Controls.OrderDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Order Details" Height="450" Width="800">
    <Grid>
        <StackPanel Margin="10">
            <TextBlock Text="Order Details" FontSize="20" FontWeight="Bold" Margin="10"/>
            <TextBlock Text="Order Time:" FontWeight="Bold" Margin="5"/>
            <TextBlock Text="{Binding OrderTime}" Margin="5"/>
            <TextBlock Text="Total Price:" FontWeight="Bold" Margin="5"/>
            <TextBlock Text="{Binding TotalPrice}" Margin="5"/>
            <TextBlock Text="Payment Method:" FontWeight="Bold" Margin="5"/>
            <TextBlock Text="{Binding PaymentMethod}" Margin="5"/>
            <!-- Daha çox xüsusiyyətlər burada -->
        </StackPanel>
    </Grid>
</Window>
