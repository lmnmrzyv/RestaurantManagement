<UserControl x:Class="RestaurantManagement.Views.Controls.ReservationsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RestaurantManagement.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="White" BorderThickness="5">
        <StackPanel>
            <Border Background="LightGray" Margin="0 0 0 10">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Height="25" FontSize="15" Padding="5" HorizontalAlignment="Left" FontFamily="TIMES NEW ROMAN" Foreground="Black">Reservation Date</TextBlock>
                        <TextBox FontSize="15" Height="25" HorizontalAlignment="Left" Width="200" FontFamily="TIMES NEW ROMAN" Text="{Binding CurrentGenre.Name,Mode=TwoWay}"/>
                        <TextBlock Height="25" FontSize="15" Padding="5" HorizontalAlignment="Left" FontFamily="TIMES NEW ROMAN" Foreground="Black">Number of People</TextBlock>
                        <TextBox FontSize="15" Height="25" HorizontalAlignment="Left" Width="200" FontFamily="TIMES NEW ROMAN" Text="{Binding CurrentGenre.Name,Mode=TwoWay}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBlock Height="25" FontSize="15" Padding="5" HorizontalAlignment="Left" FontFamily="TIMES NEW ROMAN" Foreground="Black">Table</TextBlock>
                        <TextBox FontSize="15" Height="25" HorizontalAlignment="Left" Width="200" FontFamily="TIMES NEW ROMAN" Text="{Binding CurrentGenre.Name,Mode=TwoWay}"/>
                        <TextBlock Height="25" FontSize="15" Padding="5" HorizontalAlignment="Left" FontFamily="TIMES NEW ROMAN" Foreground="Black">Customer</TextBlock>
                        <TextBox FontSize="15" Height="25" HorizontalAlignment="Left" Width="200" FontFamily="TIMES NEW ROMAN" Text="{Binding CurrentGenre.Name,Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="10">
                <Button Style="{StaticResource btnAdd}" Width="120" Height="40" Margin="5"/>
                <Button Style="{StaticResource btnChange}" Width="120" Height="40" Margin="5"/>
                <Button Style="{StaticResource btnSave}" Width="120" Height="40" Margin="5"/>
                <Button Style="{StaticResource btnReject}" Width="120" Height="40" Margin="5"/>
                <Button Style="{StaticResource btnDelete}" Width="120" Height="40" Margin="5"/>
            </StackPanel>

            <ListView ItemsSource="{Binding Reservations}" SelectedItem="{Binding SelectedGenre,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource listViewCustom}" Margin="10">
                <ListView.View>
                    <GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=No}" Header="No" Width="50"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=ReservationDate}" Header="Reservation Date" Width="150"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=NumberOfPeople}" Header="Number of People" Width="50"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=Table.TableNumber}" Header="Table" Width="100" />
                        <GridViewColumn>
                            <GridViewColumn.Header>
                                <TextBlock Text="Customer" Width="150"/>
                            </GridViewColumn.Header>
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <TextBlock Text="{Binding Path=Customer.Name}" Margin="5"/>
                                        <TextBlock Text="{Binding Path=Customer.Surname}" Margin="5" />
                                    </DockPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>


                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </Border>
</UserControl>
