<UserControl x:Class="RestaurantManagement.Views.Controls.ReservationsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RestaurantManagement.Views.Controls" 
             xmlns:viewmodels="clr-namespace:RestaurantManagement.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:ReservationsViewModel}"
             xmlns:components="clr-namespace:RestaurantManagement.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="White" BorderThickness="5" CornerRadius="10" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" ShadowDepth="4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <components:HeaderControl/>
                <Border Background="LightGray" CornerRadius="10" Padding="10" Margin="0 0 0 10">
                    <Grid Margin="10" Style="{StaticResource grdForm}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Height="25" FontSize="15" Padding="5" HorizontalAlignment="Left" FontFamily="TIMES NEW ROMAN" Foreground="Black">Reservation Date</TextBlock>
                            <TextBox FontSize="15" Height="25" HorizontalAlignment="Left" Width="200" FontFamily="TIMES NEW ROMAN" Text="{Binding CurrentReservation.ReservationDate, Mode=TwoWay}"/>
                            <TextBlock Height="25" FontSize="15" Padding="5" HorizontalAlignment="Left" FontFamily="TIMES NEW ROMAN" Foreground="Black">Number of People</TextBlock>
                            <TextBox FontSize="15" Height="25" HorizontalAlignment="Left" Width="200" FontFamily="TIMES NEW ROMAN" Text="{Binding CurrentReservation.NumberOfPeople, Mode=TwoWay}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1">
                            <TextBlock Height="25" FontSize="15" HorizontalAlignment="Left" FontFamily="TIMES NEW ROMAN" Foreground="Black">Table Capacity</TextBlock>
                            <ComboBox ItemsSource="{Binding Tables}"
                                      SelectedValue="{Binding CurrentReservation.Table.Id}"
                                      SelectedItem="{Binding CurrentReservation.Table, Mode=TwoWay}" 
                                      SelectedValuePath="Id" DisplayMemberPath="Capacity"
                                      Height="25" HorizontalAlignment="Left" Width="200"/>
                            <TextBlock Height="25" FontSize="15" HorizontalAlignment="Left" FontFamily="TIMES NEW ROMAN" Foreground="Black">Customer</TextBlock>
                            <ComboBox ItemsSource="{Binding Customers}" 
                                      SelectedValue="{Binding CurrentReservation.Customer.Id}"
                                      SelectedItem="{Binding CurrentReservation.Customer, Mode=TwoWay}"                                      
                                      SelectedValuePath="Id"                                      
                                      Height="25" HorizontalAlignment="Left" Width="200">       
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Text=" " />
                                            <TextBlock Text="{Binding Surname}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>


                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="10" Grid.Row="1" HorizontalAlignment="Center">
                <Button Style="{StaticResource btnAdd}" Width="120" Height="40" Margin="5" Content="Add"/>
                <Button Style="{StaticResource btnChange}" Width="120" Height="40" Margin="5" Content="Edit"/>
                <Button Style="{StaticResource btnSave}" Width="120" Height="40" Margin="5" Content="Save"/>
                <Button Style="{StaticResource btnReject}" Width="120" Height="40" Margin="5" Content="Reject"/>
                <Button Style="{StaticResource btnDelete}" Width="120" Height="40" Margin="5" Content="Delete"/>
            </StackPanel>

            <ListView ItemsSource="{Binding Reservations}" SelectedItem="{Binding SelectedReservation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource listViewCustom}" Margin="10" Grid.Row="2">
                <ListView.View>
                    <GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=No}" Header="No" Width="50"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=ReservationDate}" Header="Reservation Date" Width="150"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=NumberOfPeople}" Header="Number of People" Width="50"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=Table.TableNumber}" Header="Table" Width="100"/>
                        <GridViewColumn Header="Customer" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel >
                                        <TextBlock Text="{Binding Customer.Name}" />
                                        <TextBlock Text=" " />
                                        <TextBlock Text="{Binding Customer.Surname}" />
                                    </DockPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>


                    </GridView>
                </ListView.View>
            </ListView>
            <Grid Grid.Row="3" Style="{StaticResource grdSearch}" HorizontalAlignment="Right" Margin="10">
                <components:SearchControl/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
