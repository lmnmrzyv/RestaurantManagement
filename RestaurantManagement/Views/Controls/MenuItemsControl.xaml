<UserControl x:Class="RestaurantManagement.Views.Controls.MenuItemsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RestaurantManagement.Views.Controls"
             xmlns:viewmodels="clr-namespace:RestaurantManagement.ViewModels" 
             d:DataContext="{d:DesignInstance Type=viewmodels:MenuItemsViewModel}"
             xmlns:components="clr-namespace:RestaurantManagement.Views.Components"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="White" BorderThickness="5">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.5" ShadowDepth="4"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <components:HeaderControl/>
                <Border Background="LightGray"  CornerRadius="10" Padding="10"  Margin="0 0 0 10">
                    <Grid Margin="10" Style="{StaticResource grdForm}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <WrapPanel>
                            <StackPanel Grid.Row="0">
                                <TextBlock Height="25" FontSize="15" HorizontalAlignment="Left" FontFamily="TIMES NEW ROMAN" Foreground="Black">Name</TextBlock>
                                <TextBox FontSize="15" Height="25" HorizontalAlignment="Left" Width="200" FontFamily="TIMES NEW ROMAN" Text="{Binding CurrentMenuItem.name,Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Margin="50 0 0 0">
                                <TextBlock Height="25" FontSize="15" HorizontalAlignment="Left" FontFamily="TIMES NEW ROMAN" Foreground="Black">Price</TextBlock>
                                <TextBox FontSize="15" Height="25" HorizontalAlignment="Left" Width="200" FontFamily="TIMES NEW ROMAN" Text="{Binding CurrentMenuItem.price,Mode=TwoWay}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Margin="50 0 0 0">
                                <TextBlock Height="25" FontSize="15" HorizontalAlignment="Left" FontFamily="TIMES NEW ROMAN" Foreground="Black">Description</TextBlock>
                                <TextBox FontSize="15" Height="25" HorizontalAlignment="Left" Width="200" FontFamily="TIMES NEW ROMAN" Text="{Binding CurrentMenuItem.description,Mode=TwoWay}"/>
                            </StackPanel>
                        </WrapPanel>

                    </Grid>
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="10" Grid.Row="1" HorizontalAlignment="Center">
                <Button Style="{StaticResource btnAdd}" Width="120" Height="40" Margin="5"/>
                <Button Style="{StaticResource btnChange}" Width="120" Height="40" Margin="5"/>
                <Button Style="{StaticResource btnSave}" Width="120" Height="40" Margin="5"/>
                <Button Style="{StaticResource btnReject}" Width="120" Height="40" Margin="5"/>
                <Button Style="{StaticResource btnDelete}" Width="120" Height="40" Margin="5"/>
            </StackPanel>

            <ListView ItemsSource="{Binding MenuItems, Mode=TwoWay}"
               SelectedItem="{Binding SelectedMenuItem,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource listViewCustom}" Margin="10" Grid.Row="2">
                <ListView.View>
                    <GridView>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=No, Mode=TwoWay}" Header="No" Width="50"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=name}" Header="Name" Width="200"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=price}" Header="Price" Width="200"/>
                        <GridViewColumn DisplayMemberBinding="{Binding Path=description}" Header="Description" Width="200"/>
                    </GridView>
                </ListView.View>
            </ListView>
            <Grid Grid.Row="3" Style="{StaticResource grdSearch}" HorizontalAlignment="Right" Margin="10">
                <components:SearchControl/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
