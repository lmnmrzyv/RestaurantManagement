<UserControl x:Class="RestaurantManagement.Views.Controls.DiscountsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RestaurantManagement.Views.Controls"
             xmlns:viewmodels="clr-namespace:RestaurantManagement.ViewModels"
             xmlns:components="clr-namespace:RestaurantManagement.Views.Components"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:DiscountsViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">

	<Border Background="White" BorderThickness="5" CornerRadius="10" Padding="20">
		<Border.Effect>
			<DropShadowEffect Color="Black" Opacity="0.5" ShadowDepth="4"/>
		</Border.Effect>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>

			<StackPanel Grid.Row="0">
				<components:HeaderControl/>
				<Border Background="LightGray" CornerRadius="10" Padding="10" Margin="0 0 0 10">
					<Grid Margin="10" Style="{StaticResource grdForm}">
						<Grid.RowDefinitions>
							<RowDefinition Height="100"/>
							<RowDefinition Height="Auto"/>
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="250"/>
							<ColumnDefinition Width="250"/>
							<ColumnDefinition/>
						</Grid.ColumnDefinitions>
						<StackPanel Grid.Row="0" Grid.Column="0">
							<TextBlock Height="25" FontSize="15" HorizontalAlignment="Left" FontFamily="TIMES NEW ROMAN" Foreground="Black">Start Time</TextBlock>
							<TextBox FontSize="15" Height="25" HorizontalAlignment="Left" Width="200" FontFamily="TIMES NEW ROMAN" Text="{Binding CurrentDiscount.startTime, Mode=TwoWay}"/>
							<TextBlock Height="25" FontSize="15" HorizontalAlignment="Left" FontFamily="TIMES NEW ROMAN" Foreground="Black">End Time</TextBlock>
							<TextBox FontSize="15" Height="25" HorizontalAlignment="Left" Width="200" FontFamily="TIMES NEW ROMAN" Text="{Binding CurrentDiscount.endTime, Mode=TwoWay}"/>
						</StackPanel>
						<StackPanel Grid.Row="0" Grid.Column="1">
							<TextBlock Height="25" FontSize="15" HorizontalAlignment="Left" FontFamily="TIMES NEW ROMAN" Foreground="Black">Category</TextBlock>
							<ComboBox ItemsSource="{Binding Categories}" 
									  SelectedValue="{Binding CurrentDiscount.Category.Id, Mode=TwoWay}"
									  SelectedItem="{Binding CurrentDiscount.Category}"
									  SelectedValuePath="Id"
									  DisplayMemberPath="name" Height="25" Width="200" HorizontalAlignment="Left"/>
							<TextBlock Height="25" FontSize="15" HorizontalAlignment="Left" FontFamily="TIMES NEW ROMAN" Foreground="Black">Percent</TextBlock>
							<TextBox FontSize="15" Height="25" HorizontalAlignment="Left" Width="200" FontFamily="TIMES NEW ROMAN" Text="{Binding CurrentDiscount.Percent, Mode=TwoWay}"/>
						</StackPanel>
					</Grid>
				</Border>
			</StackPanel>

			<StackPanel Orientation="Horizontal" Margin="10" Grid.Row="1" HorizontalAlignment="Center">
				<Button Style="{StaticResource btnAdd}" Width="120" Height="40" Margin="5" Content="Add"/>
				<Button Style="{StaticResource btnChange}" Width="120" Height="40" Margin="5" Content="Edit"/>
				<Button Style="{StaticResource btnSave}" Width="120" Height="40" Margin="5" Content="Save"/>
				<Button Style="{StaticResource btnReject}" Width="120" Height="40" Margin="5" Content="Reject"/>
				<Button Style="{StaticResource btnDelete}" Width="120" Height="40" Margin="5" Content="Delete"/>
			</StackPanel>

			<ListView ItemsSource="{Binding Discounts}" SelectedItem="{Binding SelectedDiscount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource listViewCustom}" Margin="10" Grid.Row="2">
				<ListView.View>
					<GridView>
						<GridViewColumn DisplayMemberBinding="{Binding Path=No}" Header="No" Width="50"/>
						<GridViewColumn DisplayMemberBinding="{Binding Path=startTime, Mode=TwoWay}" Header="Start Time" Width="200"/>
						<GridViewColumn DisplayMemberBinding="{Binding Path=endTime, Mode=TwoWay}" Header="End Time" Width="200"/>
						<GridViewColumn DisplayMemberBinding="{Binding Path=Percent, Mode=TwoWay}" Header="Percent" Width="200"/>
						<GridViewColumn DisplayMemberBinding="{Binding Path=Category.name, Mode=TwoWay}" Header="Category" Width="200"/>
					</GridView>
				</ListView.View>
			</ListView>

			<Grid Grid.Row="3" Style="{StaticResource grdSearch}" HorizontalAlignment="Right" Margin="10">
				<components:SearchControl/>
			</Grid>
		</Grid>
	</Border>
</UserControl>
